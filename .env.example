# AegisMem Production & Evaluation Environment Template
# Copy this file to .env and configure strong random secrets.
# NEVER commit your real .env file.

AEGISMEM_DB_NAME=aegismem_live
AEGISMEM_DB_USER=aegis_admin
AEGISMEM_DB_PASSWORD=replace-with-strong-db-password

AEGISMEM_VAULT_NAME=aegismem_vault
AEGISMEM_VAULT_USER=vault_operator
AEGISMEM_VAULT_PASSWORD=replace-with-strong-vault-password

AEGISMEM_OWNER_TOKEN=replace-with-owner-bearer-token
AEGISMEM_INTERNAL_TOKEN=replace-with-inter-service-token
