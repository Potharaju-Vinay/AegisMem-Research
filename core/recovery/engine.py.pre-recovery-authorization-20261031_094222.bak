
from core.memory.repository import MemoryRepository

from core.recovery.executor import RecoveryExecutor
from core.recovery.models import (
    RecoveryAction,
    RecoveryDecision
)
from core.recovery.resolver import TrustedVersionResolver
from core.recovery.validator import RecoveryValidator
from core.integrity.manifest_store import IntegrityManifestStore
from core.provenance.recovery_verifier import ProvenanceRecoveryVerifier


class SelfHealingRecoveryEngine:

    
    def __init__(
        self,
    repository: MemoryRepository,
    manifest_store=None,
    provenance_manager=None,
    checkpoint_store=None,
    trusted_head_store=None,
):
        self.repository = repository

        self.manifest_store = (
        manifest_store or IntegrityManifestStore()
    )

        self.resolver = TrustedVersionResolver(
        repository,
        manifest_store=self.manifest_store
    )

        self.executor = RecoveryExecutor(
        repository,
        manifest_store=self.manifest_store,
        provenance_manager=provenance_manager,
        checkpoint_store=checkpoint_store,
        trusted_head_store=trusted_head_store,
    )

        self.validator = RecoveryValidator(
    repository,
    manifest_store=self.manifest_store,
    provenance_manager=provenance_manager,
    provenance_verifier=ProvenanceRecoveryVerifier(
        checkpoint_store=checkpoint_store,
        trusted_head_store=trusted_head_store,
    ),
)

    def plan_rollback(
        self,
        memory_id: str,
        trust_score: float
    ) -> RecoveryDecision:

        trusted = self.resolver.find_trusted_version(
            memory_id
        )

        if trusted is None:
            return RecoveryDecision(
                memory_id=memory_id,
                action=RecoveryAction.QUARANTINE,
                reason=(
                    "No sufficiently trusted historical "
                    "version was found."
                ),
                trust_score=trust_score,
                target_version=None
            )

        return RecoveryDecision(
            memory_id=memory_id,
            action=RecoveryAction.ROLLBACK,
            reason=(
                "Compromised memory has a verified "
                "trusted historical version."
            ),
            trust_score=trust_score,
            target_version=trusted.version
        )

    def recover(
        self,
        memory_id: str,
        trust_score: float
    ) -> dict:

        candidate_evaluation = self.resolver.evaluate_candidates(
            memory_id
        )

        decision = self.plan_rollback(
            memory_id,
            trust_score
        )

        print()
        print("==========================================")
        print("        AEGISMEM SELF-HEALING ENGINE")
        print("==========================================")

        print(
            f"Memory              : {memory_id}"
        )

        print(
            f"Trust Score         : {trust_score:.2f}"
        )

        print(
            f"Recovery Decision   : "
            f"{decision.action.value}"
        )

        print(
            f"Reason              : "
            f"{decision.reason}"
        )

        if decision.action == RecoveryAction.QUARANTINE:
            return {
                "success": False,
                "action": decision.action.value,
                "reason": decision.reason,
                "candidate_evaluation": candidate_evaluation
            }

        if decision.action == RecoveryAction.ROLLBACK:

            print(
                f"Trusted Version     : "
                f"v{decision.target_version}"
            )

            print()
            print("[AegisMem] Executing rollback...")

            result = self.executor.rollback(
                compromised_memory_id=memory_id,
                trusted_version=decision.target_version
            )

            if not result.success:
                print(f"[AegisMem] Rollback failed: {result.message}")
                return {
        "success": False,
        "action": result.action.value,
        "reason": result.message,
        "content_valid": False,
        "authorization_valid": False,
        "fully_verified": False,
        "validation": {
            "valid": False,
            "integrity": False,
            "trust": False,
            "status": False,
            "authorization": False,
        },
        "candidate_evaluation": candidate_evaluation,
    }

            print(
                "[AegisMem] Memory restored."
            )

            print()
            print("[AegisMem] Validating recovered state...")

            validation = self.validator.validate(
                memory_id
            )

            print(
                f"[AegisMem] Integrity       : "
                f"{'PASS' if validation['integrity'] else 'FAIL'}"
            )

            print(
                f"[AegisMem] Trust           : "
                f"{'PASS' if validation['trust'] else 'FAIL'}"
            )

            print(
                f"[AegisMem] Status          : "
                f"{'PASS' if validation['status'] else 'FAIL'}"
            )

            print(
                f"[AegisMem] Authorization   : "
                f"{'PASS' if validation['authorization'] else 'NOT VERIFIED'}"
            )

            print()

            if validation["valid"] and validation["authorization"]:
                print("SELF-HEALING AND AUTHORIZATION VERIFIED")

            elif validation["valid"]:
                print(
                    "CONTENT RECOVERY SUCCESSFUL; "
                    "AUTHORIZATION NOT VERIFIED"
                )

            else:
                print("SELF-HEALING VALIDATION FAILED")

            print("==========================================")
            
            
            print(
    f"[AegisMem] Recovery Attestation : "
    f"{'PASS' if validation.get('recovery_attestation_valid') else 'FAIL'}"
)

            print(
    f"[AegisMem] Recovery Provenance  : "
    f"{'PASS' if validation.get('recovery_provenance_verified') else 'FAIL'}"
)

            print(
    f"[AegisMem] Provenance Chain     : "
    f"{'PASS' if validation.get('provenance_verified') else 'FAIL'}"
)

            print(
    f"[AegisMem] Fully Verified       : "
    f"{'YES' if validation.get('fully_verified') else 'NO'}"
)


            content_valid = validation["valid"]
            authorization_valid = validation["authorization"]
            recovery_verified = validation.get(
                "recovery_provenance_verified",
                False
            )

            fully_verified = validation.get(
                "fully_verified",
                content_valid and authorization_valid
            )

            recovery_success = bool(
    content_valid
    and (
        authorization_valid
        or (
            recovery_verified
            and validation.get("recovery_attestation_valid", False)
            and validation.get("provenance_verified", False)
        )
    )
)
            

            return {
                "success": recovery_success,
                "content_valid": content_valid,
                "authorization_valid": authorization_valid,
                "fully_verified": fully_verified,
                "recovery_verified": recovery_verified,
                "action": result.action.value,
                "previous_version": result.previous_version,
                "restored_version": result.restored_version,
                "validation": validation,
                "candidate_evaluation": candidate_evaluation
            }

        return {
            "success": False,
            "action": decision.action.value,
            "reason": "Recovery action not implemented yet.",
            "candidate_evaluation": candidate_evaluation
        }
