.experiment-header-panel {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 30px;
  margin-bottom: 14px;
  background:
    linear-gradient(135deg, rgba(11,29,42,.96), rgba(8,14,20,.98));
}

.experiment-header-left h2 {
  margin: 7px 0 8px;
  font-size: 18px;
}

.experiment-header-left p {
  margin: 0;
  color: var(--muted);
  font-size: 9px;
}

.experiment-header-left p strong {
  color: #cfe1ec;
  font-family: var(--mono);
}

.experiment-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(105px, 1fr));
  gap: 8px;
}

.experiment-meta > div {
  min-width: 110px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: #081019;
}

.experiment-meta span {
  display: block;
  color: var(--muted-2);
  font-family: var(--mono);
  font-size: 6px;
  letter-spacing: .1em;
}

.experiment-meta strong {
  display: block;
  margin-top: 5px;
  color: #c9d8e3;
  font-family: var(--mono);
  font-size: 8px;
}

.attack-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}

.recover-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 38px;
  padding: 0 14px;
  border: 1px solid #285b43;
  border-radius: 7px;
  color: #cffff0;
  background: #0a2116;
  font-size: 9px;
  font-weight: 600;
}

.recover-button:hover {
  border-color: #3d9568;
  background: #0d2b1b;
  box-shadow: 0 0 20px rgba(74,222,128,.08);
}

.panel-subtitle {
  margin: 7px 0 0;
  color: var(--muted);
  font-size: 9px;
  line-height: 1.5;
}

.tcrp-panel {
  margin-top: 14px;
}

.tcrp-table {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #080f16;
}

.tcrp-row {
  display: grid;
  grid-template-columns: 1.4fr .8fr .8fr .7fr 1fr;
  align-items: center;
  gap: 10px;
  min-height: 45px;
  padding: 0 13px;
  border-top: 1px solid #17242f;
}

.tcrp-row:first-child {
