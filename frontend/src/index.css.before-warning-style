}

.tcrp-row:not(.tcrp-head):hover {
  background: #0b1720;
}

.tcrp-head {
  min-height: 34px;
  background: #080d13;
  color: #526a7c;
  font-family: var(--mono);
  font-size: 7px;
  letter-spacing: .08em;
}

.tcrp-row strong {
  color: #dbe8f0;
  font-family: var(--mono);
  font-size: 8px;
}

.tcrp-row span {
  color: #91a5b5;
  font-size: 8px;
}

.mono {
  font-family: var(--mono) !important;
}

.action-badge {
  display: inline-flex;
  justify-self: start;
  padding: 4px 7px;
  border-radius: 4px;
  font-family: var(--mono) !important;
  font-size: 7px !important;
  font-weight: 600;
}

.action-badge.rollback {
  color: #7ddcff;
  border: 1px solid #245a72;
  background: #0a202c;
}

.action-badge.quarantine {
  color: #f5cb66;
  border: 1px solid #574724;
  background: #1b160a;
}

.action-badge.retain {
  color: #6fe29a;
  border: 1px solid #225335;
  background: #091b11;
}

.action-badge.delete {
  color: #ff8da0;
  border: 1px solid #5b2e39;
  background: #1a0c11;
}

.tcrp-explanation {
