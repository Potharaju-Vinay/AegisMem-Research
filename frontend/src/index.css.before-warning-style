}

.tcrp-explanation span {
  display: block;
  color: var(--cyan);
  font-family: var(--mono);
  font-size: 7px;
  letter-spacing: .1em;
}

.tcrp-explanation p {
  max-width: 900px;
  margin: 7px 0 0;
  color: #7890a1;
  font-size: 9px;
  line-height: 1.6;
}

.recovery-panel {
  margin-top: 14px;
}

.recovery-banner {
