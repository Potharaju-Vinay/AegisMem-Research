import { useEffect, useState } from "react"
import {
  Activity,
  AlertTriangle,
  Bot,
  Brain,
  Database,
  GitBranch,
  LayoutDashboard,
  Lock,
  MessageSquare,
  RefreshCw,
  ShieldCheck,
  ShieldAlert,
  Sparkles,
  Terminal,
  UserRound,
  ChevronRight,
  CheckCircle2,
  Clock3,
  Search
} from "lucide-react"



const activities = [
  {
    icon: CheckCircle2,
    title: "Memory hash consistency check",
    detail: "POLICY-001 · v3",
    time: "Just now",
    type: "success"
  },
  {
    icon: ShieldCheck,
    title: "Enterprise memory protected",
    detail: "Trust verification active",
    time: "1 min ago",
    type: "success"
  },
  {
    icon: Activity,
    title: "Dependency graph synchronized",
    detail: "3 memory nodes monitored",
    time: "2 min ago",
    type: "info"
  },
  {
    icon: Clock3,
    title: "Recovery engine ready",
    detail: "TCRP available",
    time: "3 min ago",
    type: "info"
  }
]

function App() {
  const [authChecked, setAuthChecked] = useState(false)
  const [authenticated, setAuthenticated] = useState(false)
  const [loginPassword, setLoginPassword] = useState("")
  const [loginError, setLoginError] = useState("")
  const [loginLoading, setLoginLoading] = useState(false)
  const [page, setPage] = useState("overview")
  const [backend, setBackend] = useState("checking")
  const [events, setEvents] = useState([])
  const [memories, setMemories] = useState([])
  const [memoryHistory, setMemoryHistory] = useState([])
  const [selectedMemory, setSelectedMemory] = useState(null)
  const [dependencyData, setDependencyData] = useState(null)

  const [attackResult, setAttackResult] = useState(null)
  const [detectionResult, setDetectionResult] = useState(null)
  const [recoveryResult, setRecoveryResult] = useState(null)
  const [attackLoading, setAttackLoading] = useState(false)
  const [experimentRunning, setExperimentRunning] = useState(false)
  const [experimentStage, setExperimentStage] = useState("")

  const [selectedAttackType, setSelectedAttackType] =
  useState("poisoning")

  const [dashboard, setDashboard] = useState({ 
    protected_memories: 0,
    trusted_memories: 0,
    trusted_percentage: 0,
    active_threats: 0,
    corrupted_memories: 0,
    deleted_memories: 0,
    quarantined_memories: 0,
    suspicious_memories: 0,
    integrity_valid: 0,
    integrity_invalid: 0,
    integrity_percentage: 0
  })

  useEffect(() => {
    let active = true
    fetch("/api/auth/session", { credentials: "same-origin" })
      .then((response) => {
        if (!response.ok) throw new Error("Session check failed")
        return response.json()
      })
      .then((data) => {
        if (active) setAuthenticated(data.authenticated === true)
      })
      .catch(() => {
        if (active) setAuthenticated(false)
      })
      .finally(() => {
        if (active) setAuthChecked(true)
      })
    return () => { active = false }
  }, [])

  async function handleLogin(event) {
    event.preventDefault()
    if (loginLoading) return
    setLoginLoading(true)
    setLoginError("")
    try {
      const response = await fetch("/api/auth/login", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password: loginPassword })
      })
      if (!response.ok) throw new Error("Invalid password or login unavailable.")
      setAuthenticated(true)
      setLoginPassword("")
    } catch {
      setLoginError("Login failed. Check your password and try again.")
    } finally {
      setLoginLoading(false)
    }
  }

  async function handleLogout() {
    try {
      await fetch("/api/auth/logout", {
        method: "POST",
        credentials: "same-origin"
      })
    } finally {
      setAuthenticated(false)
      setLoginPassword("")
      setPage("overview")
    }
  }
  async function loadMemoryHistory(memoryId) {
  if (!memoryId) return

  try {
    const response = await fetch(
      `/api/dashboard/memories/${memoryId}/history`
    )

    if (!response.ok) {
      throw new Error("Memory history unavailable")
    }

    const data = await response.json()

    console.log(
  "AEGISMEM MEMORY HISTORY:",
  data
)

    setMemoryHistory(data.history || [])
  } catch (error) {
    console.error(
      "Memory history error:",
      error
    )

    setMemoryHistory([])
  }
}

async function loadLatestRecovery() {
  try {
    const response = await fetch(
      "/api/dashboard/latest-recovery"
    )

    if (!response.ok) {
      return
    }

    const data = await response.json()

    if (!data.found) {
      return
    }

    const recovery = data.recovery
    const memory = data.memory
    const tcrp = data.tcrp

    let candidateCosts = {}

    if (tcrp?.candidate_costs) {
      try {
        candidateCosts =
          typeof tcrp.candidate_costs === "string"
            ? JSON.parse(tcrp.candidate_costs)
            : tcrp.candidate_costs
      } catch {
        candidateCosts = {}
      }
    }

    let feasibleActions = []

    if (tcrp?.feasible_actions) {
      try {
        feasibleActions =
          typeof tcrp.feasible_actions === "string"
            ? JSON.parse(tcrp.feasible_actions)
            : tcrp.feasible_actions
      } catch {
        feasibleActions = []
      }
    }

    const validationPassed =
      String(
        recovery?.validation_result || ""
      ).toUpperCase() === "PASS"

    const decision = tcrp?.found
      ? {
          memory_id: tcrp.memory_id,

          trust_score:
            Number(tcrp.trust_score || 0),

          suspicion_score:
            Number(tcrp.suspicion_score || 0),

          impact_score:
            Number(tcrp.impact_score || 0),

          dependency_exposure:
            Number(tcrp.dependency_exposure || 0),

          selected_action_cost:
            Number(tcrp.selected_action_cost || 0),

          action:
            tcrp.action || recovery.action,

          candidate_costs:
            candidateCosts,

          feasible_actions:
            feasibleActions
        }
      : null

    setRecoveryResult({
      recovery: {
        success: String(recovery?.status || "").toLowerCase() === "success",

        decisions:
          decision
            ? [decision]
            : [],

        results: [
          {
            memory_id:
              recovery.memory_id,

            action:
              recovery.action,

            success:
              validationPassed,

            message:
              recovery.message ||
              "Recovery action executed."
          }
        ]
      },

      memory: {
        trusted: {
          version:
            memory?.trusted?.version ?? null,

          content:
            memory?.trusted?.content ?? null
        },

        compromised: {
          version:
            memory?.compromised?.version ?? null,

          content:
            memory?.compromised?.content ?? null,

          attack_type:
            memory?.compromised?.attack_type ?? null,

          attacker:
            memory?.compromised?.attacker ?? null,

          attack_id:
            memory?.compromised?.attack_id ?? null
        },

        restored: {
          version:
            memory?.restored?.version ?? null,

          content:
            memory?.restored?.content ?? null,

          trust_score:
            memory?.restored?.trust_score ?? null,

          status:
            memory?.restored?.status ?? null
        }
      },

      current_version:
        memory?.restored?.version ?? null,

      current_trust_score:
        memory?.restored?.trust_score ?? null,

      current_status:
        memory?.restored?.status ?? null,

      current_content:
        memory?.restored?.content ?? null,

      compromised_version:
        memory?.compromised?.version ?? null,

      restored_version:
        memory?.restored?.version ?? null,

      validation_result:
        recovery.validation_result,

      tcrp: {
        candidate_costs:
          candidateCosts,

        feasible_actions:
          feasibleActions,

        selected_action_cost:
          tcrp?.selected_action_cost ?? null,

        dependency_exposure:
          tcrp?.dependency_exposure ?? null
      }
    })

  } catch (error) {
    console.error(
      "Latest recovery error:",
      error
    )
  }
}

  const [question, setQuestion] = useState("")
  const [messages, setMessages] = useState([

    {
      role: "assistant",
      text: "Hello. I am the AegisMem enterprise AI assistant. Ask me a question about enterprise knowledge."
    }
  ])
  const [sending, setSending] = useState(false)

  useEffect(() => {
  async function refreshDashboard() {
    try {
      const healthResponse = await fetch("/api/health")

      if (!healthResponse.ok) {
        throw new Error("Backend unavailable")
      }

      setBackend("online")

      const dashboardResponse = await fetch(
        "/api/dashboard/overview"
      )

      if (!dashboardResponse.ok) {
        throw new Error("Dashboard telemetry unavailable")
      }

      const dashboardData = await dashboardResponse.json()

      setDashboard(dashboardData)

      const eventsResponse = await fetch(
        "/api/dashboard/events"
      )

      if (!eventsResponse.ok) {
        throw new Error("Recovery events unavailable")
      }

      const eventsData = await eventsResponse.json()

      setEvents(eventsData.events || [])

      await loadLatestRecovery()

      const memoriesResponse = await fetch(
  "/api/dashboard/memories"
)

if (!memoriesResponse.ok) {
  throw new Error("Memory data unavailable")
}

const memoriesData = await memoriesResponse.json()

setMemories(memoriesData.memories || [])

setSelectedMemory((current) => {
  if (current) {
    const updated = memoriesData.memories.find(
      (memory) => memory.id === current.id
    )

    return updated || memoriesData.memories[0] || null
  }

  return memoriesData.memories[0] || null
})



    } catch (error) {
      setBackend("offline")
      console.error(
        "Dashboard refresh error:",
        error
      )
    }
  }

  if (!authenticated) return

  refreshDashboard()

  const interval = setInterval(refreshDashboard, 2000)

  return () => clearInterval(interval)
}, [authenticated])

useEffect(() => {
  let cancelled = false

  async function loadDependencies() {
    if (!authenticated) return
    if (!selectedMemory?.id) {
      setDependencyData(null)
      return
    }

    setDependencyData(null)

    try {
      const response = await fetch(
        "/api/dashboard/dependencies/" + encodeURIComponent(selectedMemory.id)
      )

      if (!response.ok) {
        throw new Error("Dependency endpoint returned " + response.status)
      }

      const data = await response.json()

      if (!cancelled) setDependencyData(data)
    } catch (error) {
      if (!cancelled) {
        setDependencyData({
          memory_id: selectedMemory.id,
          outgoing: [],
          incoming: [],
          reachable_edges: [],
          descendants: [],
          edge_count: null,
          provenance_note: "Dependency data unavailable: " + error.message
        })
      }
    }
  }

  loadDependencies()

  return () => {
    cancelled = true
  }
}, [authenticated, selectedMemory?.id])
useEffect(() => {
  if (!authenticated) return
  if (page === "memory" && selectedMemory?.id) {
    loadMemoryHistory(selectedMemory.id)
  }

  if (page === "attack" && selectedMemory?.id) {
    loadMemoryHistory(selectedMemory.id)
  }
}, [authenticated, page, selectedMemory?.id, recoveryResult?.restored_version])

  async function sendQuestion() {
    const value = question.trim()

    if (!value || sending) return

    setMessages((current) => [
      ...current,
      { role: "user", text: value }
    ])

    setQuestion("")
    setSending(true)

    try {
      const response = await fetch("/api/chat", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          question: value
        })
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.detail || "Unable to process request")
      }

      const answer =
        data.answer ||
        data.response ||
        data.content ||
        "The enterprise agent returned a response."

      setMessages((current) => [
        ...current,
        {
          role: "assistant",
          text: answer,
          metadata: data
        }
      ])
    } catch (error) {
      setMessages((current) => [
        ...current,
        {
          role: "system",
          text:
            error.message ||
            "The enterprise backend could not process the request."
        }
      ])
    } finally {
      setSending(false)
    }
  }

  async function runPoisonAttack() {
  if (!selectedMemory?.id) { setAttackResult({ error: "Select a memory before running an attack." }); return }
  const memoryId = selectedMemory.id
  setAttackLoading(true)
  setAttackResult(null)
  setDetectionResult(null)
  setRecoveryResult(null)

  try {
    const response = await fetch("/api/attack/poison", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        memory_id: memoryId
      })
    })

    const data = await response.json()

    if (!response.ok) {
      throw new Error(
        data.detail || "Memory poisoning attack failed"
      )
    }

    setAttackResult(data)

    await loadMemoryHistory(memoryId)
  } catch (error) {
    setAttackResult({
      error: error.message
    })
  } finally {
    setAttackLoading(false)
  }
}
async function runDetection() {
  if (!selectedMemory?.id) { setDetectionResult({ error: "Select a memory before detection." }); return }
  const memoryId = selectedMemory.id
  setDetectionResult(null)

  try {
    const response = await fetch(
      "/api/aegismem/detect/" + encodeURIComponent(memoryId)
    )

    const data = await response.json()

    if (!response.ok) {
      throw new Error(
        data.detail || "Detection failed"
      )
    }

    setDetectionResult(data)
  } catch (error) {
    setDetectionResult({
      error: error.message
    })
  }
}

async function runRecovery() {
  if (!selectedMemory?.id) { setRecoveryResult({ error: "Select a memory before recovery." }); return }
  const memoryId = selectedMemory.id
  setRecoveryResult(null)

  try {
    const response = await fetch(
      "/api/aegismem/recover/" + encodeURIComponent(memoryId),
      {
        method: "POST"
      }
    )

    const data = await response.json()

    if (!response.ok) {
      throw new Error(
        data.detail || "Recovery failed"
      )
    }

    setRecoveryResult(data)

    await loadMemoryHistory(memoryId)

    const memoriesResponse = await fetch(
      "/api/dashboard/memories"
    )

    if (memoriesResponse.ok) {
      const memoriesData = await memoriesResponse.json()

      setMemories(memoriesData.memories || [])

      const recoveredMemory =
        memoriesData.memories.find(
          (memory) => memory.id === memoryId
        )

      if (recoveredMemory) {
        setSelectedMemory(recoveredMemory)
      }
    }
  } catch (error) {
    setRecoveryResult({
      error: error.message
    })
  }
}

async function runFullExperiment() {
  if (experimentRunning) return
  if (!selectedMemory?.id) { setExperimentStage("Select a memory before running the experiment."); return }
  const memoryId = selectedMemory.id

  setExperimentRunning(true)
  setExperimentStage("Launching attack...")
  setAttackResult(null)
  setDetectionResult(null)
  setRecoveryResult(null)

  try {
    const attackEndpoint = {
      poisoning: "/api/attack/poison",
      tampering: "/api/attack/tamper",
      deletion: "/api/attack/delete"
    }[selectedAttackType]

    const attackResponse = await fetch(attackEndpoint, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        memory_id: memoryId
      })
    })

    const attackData = await attackResponse.json()

    if (!attackResponse.ok) {
      throw new Error(
        attackData.detail || "Attack execution failed"
      )
    }

    setAttackResult(attackData)

    await loadMemoryHistory(memoryId)

    setExperimentStage(
      "Detecting compromised memory..."
    )

    const detectionResponse = await fetch(
      "/api/aegismem/detect/" + encodeURIComponent(memoryId)
    )

    const detectionData = await detectionResponse.json()

    if (!detectionResponse.ok) {
      throw new Error(
        detectionData.detail || "Detection failed"
      )
    }

    setDetectionResult(detectionData)

    if (!detectionData.compromised) {
      throw new Error(
        "AegisMem did not confirm the simulated compromise."
      )
    }

    setExperimentStage(
      "TCRP analyzing trust and planning recovery..."
    )

    await new Promise(
      resolve => setTimeout(resolve, 700)
    )

    setExperimentStage(
      "Executing self-healing recovery..."
    )

    const recoveryResponse = await fetch(
      "/api/aegismem/recover/" + encodeURIComponent(memoryId),
      {
        method: "POST"
      }
    )

    const recoveryData = await recoveryResponse.json()

    if (!recoveryResponse.ok) {
      throw new Error(
        recoveryData.detail || "Recovery failed"
      )
    }

    setRecoveryResult(recoveryData)

    await loadMemoryHistory(memoryId)

    const memoriesResponse = await fetch(
      "/api/dashboard/memories"
    )

    if (memoriesResponse.ok) {
      const memoriesData =
        await memoriesResponse.json()

      setMemories(
        memoriesData.memories || []
      )

      const recoveredMemory =
        memoriesData.memories.find(
          memory => memory.id === memoryId
        )

      if (recoveredMemory) {
        setSelectedMemory(recoveredMemory)
      }
    }

    const finalValidation = String(recoveryData.validation_result ?? recoveryData.recovery?.validation_result ?? "").toUpperCase()
    const finalRestoredVersion = recoveryData.memory?.restored?.version ?? recoveryData.restored_version ?? recoveryData.recovery?.restored_version ?? null
    const finalRecoverySucceeded = recoveryData.recovery?.success === true && finalRestoredVersion !== null && finalRestoredVersion !== undefined
    setExperimentStage(
      finalRecoverySucceeded && finalValidation === "PASS"
        ? "Restoration recorded; backend validation PASS. Owner authorization remains a separate check."
        : "Recovery request completed; restoration or validation evidence is incomplete. Review the recovery record."
    )

  } catch (error) {

    console.error(
      "Full experiment error:",
      error
    )

    setExperimentStage(
      `Experiment failed: ${error.message}`
    )

  } finally {

    setExperimentRunning(false)
  }
}
  function renderAttackLab() {
  const currentMemory = selectedMemory || memories[0] || null

  const latestRecovery =
    recoveryResult?.recovery?.results?.[0] || null

  const compromisedVersion =
    recoveryResult?.memory?.compromised?.version ??
    recoveryResult?.compromised_version ??
    null

  const restoredVersion =
    recoveryResult?.memory?.restored?.version ??
    recoveryResult?.restored_version ??
    null

  const validationResult = String(
    recoveryResult?.validation_result ??
    recoveryResult?.recovery?.validation_result ??
    ""
  ).toUpperCase()

  const recoverySuccessful =
    recoveryResult?.recovery?.success === true &&
    restoredVersion !== null &&
    restoredVersion !== undefined &&
    validationResult === "PASS"

const historyVersionNumber = (memory) =>
  Number(memory?.version_number ?? String(memory?.version ?? "").replace(/^v/i, ""))

const historyMatchesMemory = (memory) =>
  memory && currentMemory?.id && memory.memory_id
    ? memory.memory_id === currentMemory.id
    : Boolean(memory)

const compromisedMemory = memoryHistory.find(
  (memory) =>
    historyMatchesMemory(memory) &&
    historyVersionNumber(memory) === Number(compromisedVersion)
)

const restoredMemory = memoryHistory.find(
  (memory) =>
    historyMatchesMemory(memory) &&
    historyVersionNumber(memory) === Number(restoredVersion)
)

const trustedVersion = recoveryResult?.memory?.trusted?.version ?? null

const trustedContent =
  recoveryResult?.memory?.trusted?.content ??
  "Trusted memory content was not supplied by the recovery record."

const compromisedContent =
  recoveryResult?.memory?.compromised?.content ??
  compromisedMemory?.content ??
  "No compromised content recorded."
const latestEvent =
    events.length > 0 ? events[0] : null

  const attackDetected =
    compromisedVersion !== null &&
    compromisedVersion !== undefined

  return (
    <div className="page-content">

      {/* HEADER */}

      <div className="page-heading">

        <div>

          <div className="eyebrow">
            LIVE SECURITY MONITOR
          </div>

          <h1>
            AegisMem Live Recovery
          </h1>

          <p>
            Observe how AegisMem detects a compromised
            memory, selects a recovery action, restores
            trusted knowledge, and validates the result.
          </p>

        </div>

        <div className="system-pill">
          <span
            className={`status-dot ${backend}`}
          ></span>

          AegisMem{" "}
          {backend === "online"
            ? "Operational"
            : "Offline"}
        </div>

      </div>


      {/* SECURITY STATUS */}

      <section className="panel">

        <div className="panel-header">

          <div>

            <span className="panel-kicker">
              SECURITY STATUS
            </span>

            <h2>
              {recoverySuccessful
                ? "Recovery Validation Passed"
                : attackDetected
                ? "Compromise Evidence Recorded"
                : "No linked compromise evidence"}
            </h2>

          </div>

          {recoverySuccessful ? (
            <CheckCircle2 size={22} />
          ) : attackDetected ? (
            <AlertTriangle size={22} />
          ) : (
            <ShieldCheck size={22} />
          )}

        </div>


        <div className="live-status-card">

          <div className="live-status-icon">

            {recoverySuccessful ? (
              <CheckCircle2 size={26} />
            ) : attackDetected ? (
              <AlertTriangle size={26} />
            ) : (
              <ShieldCheck size={26} />
            )}

          </div>

          <div>

            <strong>
              {recoverySuccessful
                ? "Compromised memory recovered"
                : attackDetected
                ? "Compromise-associated memory record found"
                : "No linked compromise evidence is available in the current recovery result"}
            </strong>

            <span>
              {recoverySuccessful
                ? "A restored version is recorded and the backend reports validation PASS. Owner authorization must be assessed separately."
                : attackDetected
                ? "AegisMem is analyzing the affected memory and determining recovery."
                : "This status does not establish whether an attack is currently in progress."}
            </span>

          </div>

        </div>

      </section>


      {/* MEMORY RECOVERY STORY */}

      <section className="panel">

        <div className="panel-header">

          <div>

            <span className="panel-kicker">
              MEMORY INTEGRITY
            </span>

            <h2>
              Historical → Compromise Evidence → Restoration
            </h2>

          </div>

          <Database size={20} />

        </div>


        <div className="memory-recovery-flow">

          {/* TRUSTED */}

          <div className="memory-state trusted">

            <span className="memory-state-label">
              TRUSTED STATE
            </span>

            <strong>
  {trustedVersion !== null
    ? `v${trustedVersion}`
    : "-"}
</strong>

            <p>
              {trustedContent}
            </p>

            <div className="memory-state-status">
              <Database size={15} />
              {trustedVersion !== null
                ? "Historical reference"
                : "Reference unavailable"}
            </div>

          </div>


          <div className="recovery-arrow">
            <ChevronRight size={22} />
          </div>


          {/* COMPROMISED */}

          <div className="memory-state compromised">

            <span className="memory-state-label">
              ATTACKED STATE
            </span>

            <strong>
  {compromisedVersion !== null
    ? `v${compromisedVersion}`
    : "-"}
</strong>

            <p>
              {compromisedContent}
            </p>

            <div className="memory-state-status">
              {compromisedVersion !== null ? (
                <AlertTriangle size={15} />
              ) : (
                <Activity size={15} />
              )}
              {compromisedVersion !== null
                ? "Compromise-associated record"
                : "No linked record"}
            </div>

{recoveryResult?.memory?.compromised?.attack_type && (
  <small>
    {recoveryResult.memory.compromised.attack_type}
    {recoveryResult.memory.compromised.attacker
      ? ` · ${recoveryResult.memory.compromised.attacker}`
      : ""}
  </small>
)}

          </div>


          <div className="recovery-arrow">
            <ChevronRight size={22} />
          </div>


          {/* RECOVERED */}

          <div className="memory-state recovered">

            <span className="memory-state-label">
              RECOVERED STATE
            </span>

            <strong>
  {restoredVersion !== null
    ? `v${restoredVersion}`
    : currentMemory?.version
    ? `v${currentMemory.version}`
    : "-"}
</strong>

            <p>
  {recoveryResult?.memory?.restored?.content ??
    restoredMemory?.content ??
    "Restored content was not supplied by the recovery record."}
</p>

            <div className="memory-state-status">
              {recoverySuccessful ? (
                <>
                  <CheckCircle2 size={15} />
                  Validation passed
                </>
              ) : restoredVersion !== null && restoredVersion !== undefined ? (
                <>
                  <AlertTriangle size={15} />
                  Restoration recorded; validation not confirmed
                </>
              ) : (
                <>
                  <AlertTriangle size={15} />
                  Restoration evidence unavailable
                </>
              )}
            </div>

          </div>

        </div>

      </section>


      {/* AEGISMEM RESPONSE */}

      <section className="panel">

        <div className="panel-header">

          <div>

            <span className="panel-kicker">
              AEGISMEM RESPONSE
            </span>

            <h2>
              Automatic Self-Healing Process
            </h2>

          </div>

          <ShieldCheck size={20} />

        </div>


        <div className="recovery-steps">

          <div className={`recovery-step ${Boolean(recoveryResult?.memory?.compromised?.attack_id || recoveryResult?.memory?.compromised?.version != null) ? "completed" : "pending"}`}>
            <div className="recovery-step-number">01</div>
            <div>
              <strong>Detect</strong>
              <span>
                {recoveryResult?.memory?.compromised?.attack_id || recoveryResult?.memory?.compromised?.version != null
                  ? "Compromise-associated record found"
                  : "No recovery-linked attack evidence available"}
              </span>
            </div>
            <span className="recovery-step-state">
              {recoveryResult?.memory?.compromised?.attack_id || recoveryResult?.memory?.compromised?.version != null ? "Recorded" : "Pending"}
            </span>
          </div>

          <div className={`recovery-step ${Boolean(recoveryResult?.memory?.compromised?.version != null && (recoveryResult?.memory?.compromised?.attack_type || recoveryResult?.memory?.compromised?.content != null)) ? "completed" : "pending"}`}>
            <div className="recovery-step-number">02</div>
            <div>
              <strong>Diagnose</strong>
              <span>
                {recoveryResult?.memory?.compromised?.version != null
                  ? `Compromised version: ${recoveryResult.memory.compromised.version}`
                  : "Compromise details not available"}
              </span>
            </div>
            <span className="recovery-step-state">
              {recoveryResult?.memory?.compromised?.version != null && (recoveryResult?.memory?.compromised?.attack_type || recoveryResult?.memory?.compromised?.content != null) ? "Evidence available" : "Pending"}
            </span>
          </div>

          <div className={`recovery-step ${Boolean(recoveryResult?.recovery?.decisions?.length || recoveryResult?.tcrp?.found || recoveryResult?.tcrp?.action) ? "completed" : "pending"}`}>
            <div className="recovery-step-number">03</div>
            <div>
              <strong>TCRP decision</strong>
              <span>
                Action: {recoveryResult?.recovery?.decisions?.[0]?.action || recoveryResult?.tcrp?.action || "No recorded decision"}
              </span>
            </div>
            <span className="recovery-step-state">
              {recoveryResult?.recovery?.decisions?.length || recoveryResult?.tcrp?.found || recoveryResult?.tcrp?.action ? "Recorded" : "Pending"}
            </span>
          </div>

          <div className={`recovery-step ${(recoveryResult?.restored_version ?? recoveryResult?.memory?.restored?.version) != null && (recoveryResult?.current_content ?? recoveryResult?.memory?.restored?.content) != null ? "completed" : "pending"}`}>
            <div className="recovery-step-number">04</div>
            <div>
              <strong>Recover</strong>
              <span>
                {(recoveryResult?.restored_version ?? recoveryResult?.memory?.restored?.version) != null && (recoveryResult?.current_content ?? recoveryResult?.memory?.restored?.content) != null
                  ? `Restored version ${recoveryResult?.restored_version ?? recoveryResult?.memory?.restored?.version} has recorded content`
                  : "Restoration evidence not available"}
              </span>
            </div>
            <span className="recovery-step-state">
              {(recoveryResult?.restored_version ?? recoveryResult?.memory?.restored?.version) != null && (recoveryResult?.current_content ?? recoveryResult?.memory?.restored?.content) != null ? "Recorded" : "Pending"}
            </span>
          </div>

          <div className={`recovery-step ${String(recoveryResult?.validation_result ?? recoveryResult?.recovery?.validation_result ?? "").toUpperCase() === "PASS" ? "completed" : String(recoveryResult?.validation_result ?? recoveryResult?.recovery?.validation_result ?? "").toUpperCase() === "FAIL" ? "failed" : "pending"}`}>
            <div className="recovery-step-number">05</div>
            <div>
              <strong>Validate</strong>
              <span>
                Recorded validation result: {recoveryResult?.validation_result ?? recoveryResult?.recovery?.validation_result ?? "Not available"}
              </span>
              <small>Validation PASS alone does not establish owner authorization.</small>
            </div>
            <span className="recovery-step-state">
              {String(recoveryResult?.validation_result ?? recoveryResult?.recovery?.validation_result ?? "").toUpperCase() === "PASS"
                ? "Passed"
                : String(recoveryResult?.validation_result ?? recoveryResult?.recovery?.validation_result ?? "").toUpperCase() === "FAIL"
                  ? "Failed"
                  : "Pending"}
            </span>
          </div>

        </div>
      </section>


      {/* TCRP DECISION */}

      <section className="panel">

        <div className="panel-header">

          <div>

            <span className="panel-kicker">
              TCRP DECISION
            </span>

            <h2>
              Why was the memory rolled back?
            </h2>

          </div>

          <GitBranch size={20} />

        </div>


        <div className="decision-summary">

          <div className="decision-action">

            <span>
              SELECTED RECOVERY ACTION
            </span>

            <strong>
              {recoveryResult?.recovery?.decisions?.[0]?.action || recoveryResult?.tcrp?.action || "No recorded decision"}
            </strong>

          </div>


          <div className="decision-explanation">

            <strong>
              Recorded TCRP decision evidence
            </strong>

            <p>The panel reports only decision fields returned by the backend. A recorded action does not, by itself, prove successful restoration or owner authorization.</p>

          </div>

        </div>


        <details className="technical-details">

          <summary>
            View technical TCRP evidence
          </summary>

          <div className="technical-grid">

            <div>
              <span>
                Trust
              </span>

              <strong>
                {(recoveryResult?.recovery?.decisions?.[0]?.trust_score ?? recoveryResult?.tcrp?.trust_score) != null ? Number(recoveryResult?.recovery?.decisions?.[0]?.trust_score ?? recoveryResult?.tcrp?.trust_score).toFixed(2) : "Not recorded"}
              </strong>
            </div>

            <div>
              <span>
                Suspicion
              </span>

              <strong>
                {(recoveryResult?.recovery?.decisions?.[0]?.suspicion_score ?? recoveryResult?.tcrp?.suspicion_score) != null ? Number(recoveryResult?.recovery?.decisions?.[0]?.suspicion_score ?? recoveryResult?.tcrp?.suspicion_score).toFixed(2) : "Not recorded"}
              </strong>
            </div>

            <div>
              <span>
                Impact
              </span>

              <strong>
                {(recoveryResult?.recovery?.decisions?.[0]?.impact_score ?? recoveryResult?.tcrp?.impact_score) != null ? Number(recoveryResult?.recovery?.decisions?.[0]?.impact_score ?? recoveryResult?.tcrp?.impact_score).toFixed(2) : "Not recorded"}
              </strong>
            </div>

            <div>
              <span>
                Selected Cost
              </span>

              <strong>
                {(recoveryResult?.recovery?.decisions?.[0]?.selected_action_cost ?? recoveryResult?.tcrp?.selected_action_cost) != null ? Number(recoveryResult?.recovery?.decisions?.[0]?.selected_action_cost ?? recoveryResult?.tcrp?.selected_action_cost).toFixed(4) : "Not recorded"}
              </strong>
            </div>

          </div>

        </details>

      </section>


      {/* VALIDATION */}

      <section className="panel">

        <div className="panel-header">

          <div>

            <span className="panel-kicker">
              VALIDATION
            </span>

            <h2>
              Recovery Verification
            </h2>

          </div>

          <CheckCircle2 size={20} />

        </div>


        <div className={`recovery-banner ${recoverySuccessful ? "success" : "warning"}`}>

          {recoverySuccessful ? <CheckCircle2 size={22} /> : <AlertTriangle size={22} />}

          <div>

            <strong>
              {recoverySuccessful
                ? "Recovery record reports validation PASS"
                : "Recovery validation status"}
            </strong>

            <span>
              {recoverySuccessful
                ? "A restored version is recorded and backend validation reports PASS. Owner authorization and current active state are separate checks."
                : "No complete successful recovery record with a restored version and validation PASS is available in the current result."}
            </span>

          </div>

        </div>

      </section>


      {/* DEPENDENCY IMPACT */}
<section className="panel">
  <div className="panel-header">
    <div>
      <span className="panel-kicker">DEPENDENCY IMPACT</span>
      <h2>Stored Memory Relationships</h2>
    </div>
    <GitBranch size={20} />
  </div>

  <div className="dependency-flow">
    <div className="dependency-node root">
      <strong>{currentMemory?.id || "No memory selected"}</strong>
      <span>Selected memory</span>
    </div>

    {!currentMemory?.id ? (
      <p>No memory is selected.</p>
    ) : dependencyData?.memory_id !== currentMemory.id ? (
      <p>Loading dependency records for the selected memory…</p>
    ) : dependencyData?.provenance_note?.startsWith("Dependency data unavailable:") ? (
      <p>{dependencyData.provenance_note}</p>
    ) : (dependencyData?.reachable_edges || []).length === 0 ? (
      <p>No stored reachable dependency edges were returned for this memory.</p>
    ) : (
      <div className="dependency-edges">
        {(dependencyData.reachable_edges || []).map((edge) => (
          <div className="dependency-node" key={edge.id}>
            <strong>{edge.source_memory_id} → {edge.target_memory_id}</strong>
            <span>
              {edge.dependency_type || "Type not recorded"} · Strength:{" "}
              {typeof edge.strength === "number" ? edge.strength : "Not recorded"}
            </span>
            <span>
              Edge ID: {edge.id ?? "Not recorded"} · Source record:{" "}
              {edge.source_record_id ?? "Not linked"} · Target record:{" "}
              {edge.target_record_id ?? "Not linked"}
            </span>
          </div>
        ))}
      </div>
    )}
  </div>

  <p className="dependency-explanation">
    {dependencyData?.memory_id === currentMemory?.id
      ? dependencyData.provenance_note || "Provenance metadata was not supplied by the backend."
      : "Dependency provenance is not yet available for the selected memory."}
  </p>
  {dependencyData?.memory_id === currentMemory?.id && (
    <p className="dependency-explanation">
      Incoming edges: {(dependencyData.incoming || []).length} ·
      Outgoing edges: {(dependencyData.outgoing || []).length} ·
      Reachable edges: {dependencyData.edge_count ?? "Not recorded"}
    </p>
  )}
</section>

{/* RECOVERY RECORD */}

{recoveryResult?.recovery?.results?.length > 0 && (

  <section className="panel">

    <div className="panel-header">

      <div>

        <span className="panel-kicker">
          RECOVERY RECORD
        </span>

        <h2>
          Latest Recovery
        </h2>

      </div>

      <Activity size={20} />

    </div>


    <div className="recovery-record-card">

      <div className="recovery-record-main">

        <div className="recovery-record-action">

          {recoverySuccessful ? <CheckCircle2 size={22} /> : <AlertTriangle size={22} />}

          <div>

            <strong>
              {recoveryResult.recovery.results[0].action}
            </strong>

            <span>
              {recoveryResult.recovery.results[0].memory_id}
            </span>

          </div>

        </div>


        <div className="recovery-record-message">

          <strong>
            Recovery completed
          </strong>

          <span>
            {recoveryResult.recovery.results[0].message ||
              "Memory rollback executed successfully."}
          </span>

        </div>

      </div>


      <div className="recovery-record-flow">

        <div>

          <span>
            COMPROMISED
          </span>

          <strong>
            v{recoveryResult.compromised_version}
          </strong>

        </div>


        <ChevronRight size={20} />


        <div>

          <span>
            RESTORED
          </span>

          <strong>
            v{recoveryResult.restored_version}
          </strong>

        </div>


        <div className="recovery-record-status">

          <CheckCircle2 size={17} />

          <span>
            {recoveryResult.validation_result === "PASS"
              ? "VALIDATED"
              : "PENDING"}
          </span>

        </div>

      </div>

    </div>

  </section>

)}

    </div>
  )
}

  function renderOverview() {
  const latestRecovery = recoveryResult?.recovery?.results?.[0] || null
  const latestDecision =
    recoveryResult?.recovery?.decisions?.[0] || null

  const trustedVersion =
    recoveryResult?.memory?.trusted?.version ?? null

  const compromisedVersion =
    recoveryResult?.memory?.compromised?.version ?? null

  const restoredVersion =
    recoveryResult?.memory?.restored?.version ?? null

  const trustedContent =
    recoveryResult?.memory?.trusted?.content ||
    "No trusted baseline recorded."

  const compromisedContent =
    recoveryResult?.memory?.compromised?.content ||
    "No compromised state recorded."

  const restoredContent =
    recoveryResult?.memory?.restored?.content ||
    "No restored state recorded."

  const attackType =
    recoveryResult?.memory?.compromised?.attack_type ||
    "memory tampering"

  const attacker =
    recoveryResult?.memory?.compromised?.attacker ||
    "external actor"

  const recoveryPassed =
    recoveryResult?.validation_result === "PASS"

  return (
    <div className="page-content">

      <div className="page-heading">

        <div>
          <div className="eyebrow">
            SECURITY CONTROL CENTER
          </div>

          <h1>
            Enterprise AI Memory Protection
          </h1>

          <p>
            Monitor persistent memory integrity, trust,
            dependencies and autonomous self-healing.
          </p>
        </div>

        <div className="system-pill">
          <span className={`status-dot ${backend}`}></span>
          Backend{" "}
          {backend === "online"
            ? "Online"
            : backend === "offline"
            ? "Offline"
            : "Checking"}
        </div>

      </div>


      {/* SECURITY METRICS */}

      <div className="stat-grid">

        <StatCard
  icon={Database}
  label="Protected Memories"
  value={dashboard.protected_memories}
  detail="Currently monitored"
/>
        <StatCard
          icon={ShieldCheck}
          label="Trusted Memories"
          value={`${dashboard.trusted_percentage}%`}
          detail={`${dashboard.trusted_memories} of ${dashboard.protected_memories} trusted`}
        />

        <StatCard
          icon={ShieldAlert}
          label="At-Risk Memories"
          value={dashboard.active_threats}
          detail={`${dashboard.quarantined_memories} quarantined`}
        />

        <StatCard
  icon={RefreshCw}
  label="Recovery Incidents"
  value={dashboard.recovery_events}
  detail="Successful recovery incidents"
/>

      </div>


      {/* PROTECTION PIPELINE + INTEGRITY */}

      <div className="dashboard-grid">

        <section className="panel large-panel">

          <div className="panel-header">

            <div>
              <span className="panel-kicker">
                MEMORY SECURITY
              </span>

              <h2>
                Protection Pipeline
              </h2>
            </div>

            <ShieldCheck size={20} />

          </div>

          <div className="pipeline">

            <PipelineItem
              number="01"
              title="Detect"
              text="Identify suspicious memory state"
              active
            />

            <ChevronRight className="pipeline-arrow" />

            <PipelineItem
              number="02"
              title="Assess"
              text="Evaluate integrity and trust"
            />

            <ChevronRight className="pipeline-arrow" />

            <PipelineItem
              number="03"
              title="TCRP"
              text="Plan dependency-aware recovery"
            />

            <ChevronRight className="pipeline-arrow" />

            <PipelineItem
              number="04"
              title="Recover"
              text="Restore trusted historical state"
            />

            <ChevronRight className="pipeline-arrow" />

            <PipelineItem
              number="05"
              title="Validate"
              text="Confirm restored memory"
            />

          </div>

        </section>


        <section className="panel">

          <div className="panel-header">

            <div>
              <span className="panel-kicker">
                SYSTEM HEALTH
              </span>

              <h2>
                Memory Integrity
              </h2>
            </div>

            <Activity size={20} />

          </div>

          <div className="health-ring">

            <div className="health-value">

              <strong>
                {dashboard.integrity_percentage}%
              </strong>

              <span>
                Hash consistency checks passed
              </span>

            </div>

          </div>

          <div className="health-row">
            <span>
              Integrity checks
            </span>

            <strong>
              {dashboard.integrity_valid} /{" "}
              {dashboard.integrity_valid +
                dashboard.integrity_invalid}
            </strong>
          </div>

          <div className="health-row">
            <span>
              Suspicious memories
            </span>

            <strong>
              {dashboard.suspicious_memories}
            </strong>
          </div>

          <div className="health-row">
            <span>
              Quarantined
            </span>

            <strong>
              {dashboard.quarantined_memories}
            </strong>
          </div>

        </section>

      </div>


      {/* LATEST REAL INCIDENT */}

      {latestRecovery && (

        <section className="panel incident-panel">

          <div className="panel-header">

            <div>
              <span className="panel-kicker">
                LATEST RECOVERY INCIDENT
              </span>

              <h2>
                Compromised Memory Contained
              </h2>
            </div>

            <div className="incident-status">
              <CheckCircle2 size={17} />
              {recoveryPassed
                ? "VALIDATED"
                : "RECOVERY RECORDED"}
            </div>

          </div>


          <div className="incident-meta">

            <div>
              <span>
                MEMORY
              </span>

              <strong>
                {latestRecovery.memory_id}
              </strong>
            </div>

            <div>
              <span>
                ATTACK
              </span>

              <strong>
                {attackType}
              </strong>
            </div>

            <div>
              <span>
                SOURCE
              </span>

              <strong>
                {attacker}
              </strong>
            </div>

            <div>
              <span>
                ACTION
              </span>

              <strong>
                {latestDecision?.action ||
                  latestRecovery.action}
              </strong>
            </div>

          </div>


          <div className="incident-flow">

            <div className="incident-state trusted">

              <span>
                TRUSTED
              </span>

              <strong>
                {trustedVersion !== null
                  ? `v${trustedVersion}`
                  : "-"}
              </strong>

              <p>
                {trustedContent}
              </p>

            </div>


            <ChevronRight className="incident-arrow" />


            <div className="incident-state compromised">

              <span>
                COMPROMISED
              </span>

              <strong>
                {compromisedVersion !== null
                  ? `v${compromisedVersion}`
                  : "-"}
              </strong>

              <p>
                {compromisedContent}
              </p>

            </div>


            <ChevronRight className="incident-arrow" />


            <div className="incident-state recovered">

              <span>
                RESTORED
              </span>

              <strong>
                {restoredVersion !== null
                  ? `v${restoredVersion}`
                  : "-"}
              </strong>

              <p>
                {restoredContent}
              </p>

            </div>

          </div>


          <div className="incident-footer">

            <div className="incident-result">

              <CheckCircle2 size={18} />

              <div>
                <strong>
                  Autonomous recovery completed
                </strong>

                <span>
                  TCRP selected{" "}
                  {latestDecision?.action ||
                    latestRecovery.action}{" "}
                  and the restored memory passed validation.
                </span>
              </div>

            </div>

            <button
              className="text-button"
              onClick={() => setPage("attack")}
            >
              View Live Recovery
              <ChevronRight size={15} />
            </button>

          </div>

        </section>

      )}


      {/* PROTECTED KNOWLEDGE */}

      <section className="panel">

        <div className="panel-header">

          <div>
            <span className="panel-kicker">
              ENTERPRISE MEMORY
            </span>

            <h2>
              Protected Knowledge
            </h2>
          </div>

          <button
            className="text-button"
            onClick={() => setPage("memory")}
          >
            View all
            <ChevronRight size={15} />
          </button>

        </div>


        <div className="memory-list">

          {memories.map((memory) => (

            <button
              className="memory-row"
              key={memory.id}
              onClick={() => {
                setSelectedMemory(memory)
                setPage("memory")
                loadMemoryHistory(memory.id)
              }}
            >

              <div className="memory-icon">
                <Database size={17} />
              </div>

              <div className="memory-main">

                <strong>
                  {memory.id}
                </strong>

                <span>
                  {memory.source_type}
                </span>

              </div>

              <div className="memory-trust">

                <strong>
                  {memory.trust.toFixed(2)}
                </strong>

                <span>
                  Trust
                </span>

              </div>

              <span className="badge active">
                {memory.status}
              </span>

            </button>

          ))}

        </div>

      </section>

    </div>
  )
}

  function renderAssistant() {
  const lastMessage =
    messages[messages.length - 1]

  const metadata =
    lastMessage?.metadata || null

  const isVerified =
    metadata?.aegismem_verified === true

  const currentMemory = selectedMemory || memories[0] || null

  const recoverySuccessful =
    recoveryResult?.recovery?.success === true

  return (
    <div className="page-content assistant-page">

      <div className="page-heading">
        <div>
          <div className="eyebrow">
            PROTECTED AI ASSISTANT
          </div>

          <h1>
            AegisMem AI Assistant
          </h1>

          <p>
            Ask the enterprise agent a question. AegisMem
            verifies persistent memory before it is used.
          </p>
        </div>

        <div className="system-pill">
          <span className="status-dot online"></span>
          Memory Protection Active
        </div>
      </div>

      <div className="assistant-layout">

        <section className="chat-panel">

          <div className="chat-header">
            <div className="agent-avatar">
              <Bot size={22} />
            </div>

            <div>
              <strong>
                Enterprise AI Agent
              </strong>

              <span>
                Protected by AegisMem
              </span>
            </div>

            <div className="chat-live">
              <span className="status-dot online"></span>
              Protected
            </div>
          </div>

          <div className="chat-messages">

            {messages.map((message, index) => {

              const verified =
                message.metadata?.aegismem_verified === true

              return (
                <div
                  key={index}
                  className={`message ${message.role}`}
                >

                  <div className="message-avatar">

                    {message.role === "user" ? (
                      <UserRound size={16} />
                    ) : message.role === "system" ? (
                      <AlertTriangle size={16} />
                    ) : (
                      <Bot size={16} />
                    )}

                  </div>

                  <div className="message-body">

                    <span className="message-role">
                      {message.role === "user"
                        ? "YOU"
                        : message.role === "system"
                        ? "SYSTEM"
                        : "AEGISMEM AGENT"}
                    </span>

                    <p>
                      {message.text}
                    </p>

                    {message.metadata && (
                      <div className="response-metadata">

                        {message.metadata.memory_used && (
                          <span>
                            {message.metadata.memory_id || currentMemory?.id || "Memory ID unavailable"} · v{message.metadata.memory_version}
                          </span>
                        )}

                        {verified && (
                          <span>
                            ✓ Memory Verified
                          </span>
                        )}

                        {message.metadata.status && (
                          <span>
                            {message.metadata.status}
                          </span>
                        )}

                      </div>
                    )}

                  </div>

                </div>
              )
            })}

            {sending && (
              <div className="message assistant">

                <div className="message-avatar">
                  <Bot size={16} />
                </div>

                <div className="message-body">

                  <span className="message-role">
                    AEGISMEM AGENT
                  </span>

                  <p className="typing">
                    Verifying trusted memory...
                  </p>

                </div>

              </div>
            )}

          </div>

          <div className="chat-input-area">

            <input
              value={question}
              onChange={(event) =>
                setQuestion(event.target.value)
              }
              onKeyDown={(event) => {
                if (event.key === "Enter") {
                  sendQuestion()
                }
              }}
              placeholder="Ask: What is the refund policy?"
            />

            <button
              onClick={sendQuestion}
              disabled={sending}
            >
              <MessageSquare size={18} />
            </button>

          </div>

        </section>


        <aside className="assistant-sidebar">

          <section className="panel">

            <div className="panel-header">

              <div>
                <span className="panel-kicker">
                  MEMORY STATUS
                </span>

                <h2>
                  Protected Knowledge
                </h2>
              </div>

              <ShieldCheck size={19} />

            </div>


            <div className="source-card">

              <div className="source-title">

                <Database size={17} />

                <strong>
                  Customer Refund Policy
                </strong>

              </div>

              <p>
                {currentMemory?.content ||
                  "Waiting for memory telemetry..."}
              </p>

              <div className="source-grid">

                <span>
                  Memory
                </span>

                <strong>
                  {currentMemory?.id || "No memory selected"}
                </strong>

                <span>
                  Version
                </span>

                <strong>
                  v{currentMemory?.version || "-"}
                </strong>

                <span>
                  Trust
                </span>

                <strong>
                  {currentMemory
                    ? Number(
                        currentMemory.trust
                      ).toFixed(2)
                    : "-"}
                </strong>

                <span>
                  Status
                </span>

                <strong>
                  {currentMemory?.status || "-"}
                </strong>

              </div>

            </div>


            <div className="verified-box">

              {isVerified ? (
                <>
                  <CheckCircle2 size={18} />

                  <div>

                    <strong>
                      Trusted memory
                    </strong>

                    <span>
                      AegisMem verified this memory
                      before the response.
                    </span>

                  </div>
                </>
              ) : (
                <>
                  <Lock size={18} />

                  <div>

                    <strong>
                      Verification not confirmed
                    </strong>

                    <span>
                      Enterprise memory is verified
                      before use.
                    </span>

                  </div>
                </>
              )}

            </div>

          </section>


          <section className="panel">

            <div className="panel-header">

              <div>
                <span className="panel-kicker">
                  DEMO FLOW
                </span>

                <h2>
                  How AegisMem Protects the Agent
                </h2>
              </div>

              <ShieldCheck size={19} />

            </div>


            <div className="mini-flow">

              <div>
                <strong>
                  01
                </strong>

                <span>
                  User asks a question
                </span>
              </div>

              <div>
                <strong>
                  02
                </strong>

                <span>
                  Agent retrieves memory
                </span>
              </div>

              <div>
                <strong>
                  03
                </strong>

                <span>
                  AegisMem verifies memory
                </span>
              </div>

              <div>
                <strong>
                  04
                </strong>

                <span>
                  Agent generates answer
                </span>
              </div>

            </div>

          </section>


          {recoverySuccessful && (
            <section className="panel">

              <div className="panel-header">

                <div>
                  <span className="panel-kicker">
                    RECOVERY EVIDENCE
                  </span>

                  <h2>
                    Recovery Validation
                  </h2>
                </div>

                <CheckCircle2 size={19} />

              </div>

              <div className={`recovery-banner ${recoverySuccessful ? "success" : "warning"}`}>

                <CheckCircle2 size={21} />

                <div>

                  <strong>
                    Recovery record available
                  </strong>

                  <span>
                    The recovery record reports validation PASS. Owner authorization and current-memory verification remain separate checks.
                  </span>

                </div>

              </div>

            </section>
          )}

        </aside>

      </div>

    </div>
  )
}

  function renderMemory() {
    return (
      <div className="page-content">
        <div className="page-heading">
          <div>
            <div className="eyebrow">PERSISTENT MEMORY</div>
            <h1>Enterprise Memory Database</h1>
            <p>
              Versioned enterprise knowledge protected by integrity and trust
              controls.
            </p>
          </div>

          <div className="search-box">
            <Search size={17} />
            <input placeholder="Search memory..." />
          </div>
        </div>

        <div className="memory-layout">
          <section className="panel">
  <div className="table-header">
    <div>
      <span className="panel-kicker">MEMORY RECORDS</span>
      <h2>Protected Knowledge</h2>
    </div>

    <span className="record-count">
      {memories.length} monitored records
    </span>
  </div>

  <div className="memory-table">
    <div className="table-row table-head">
      <span>Memory</span>
      <span>Type</span>
      <span>Version</span>
      <span>Trust</span>
      <span>Status</span>
    </div>

    {memories.map((memory) => (
      <button
        className={`table-row table-data ${
          selectedMemory?.id === memory.id ? "selected" : ""
        }`}
        key={memory.id}
        onClick={() => {
          setSelectedMemory(memory)
          loadMemoryHistory(memory.id)
        }}
      >
        <span>
          <strong>{memory.id}</strong>
        </span>

        <span>{memory.source_type}</span>

        <span>{memory.version}</span>

        <span className="trust-value">
          {Number(memory.trust).toFixed(2)}
        </span>

        <span>
          <span className={`badge ${memory.status.toLowerCase()}`}>
            {memory.status}
          </span>
        </span>
      </button>
    ))}
  </div>

  <div className="memory-security-summary">

    <div className="memory-summary-header">
      <div>
        <span className="panel-kicker">
          SECURITY STATE
        </span>

        <strong>
          Current memory posture
        </strong>
      </div>

      <ShieldCheck size={18} />
    </div>

    <div className="memory-summary-grid">

      <div>
        <span>PROTECTED</span>
        <strong>{dashboard.protected_memories}</strong>
      </div>

      <div>
        <span>TRUSTED</span>
        <strong>{dashboard.trusted_memories}</strong>
      </div>

      <div>
        <span>QUARANTINED</span>
        <strong>{dashboard.quarantined_memories}</strong>
      </div>

      <div>
        <span>INTEGRITY</span>
        <strong>{dashboard.integrity_percentage}%</strong>
      </div>

    </div>

  </div>
</section>

          <section className="panel memory-detail">
            <div className="panel-header">
              <div>
                <span className="panel-kicker">MEMORY DETAIL</span>
                <h2>{selectedMemory?.id || "Loading..."}</h2>
              </div>
              <ShieldCheck size={21} />
            </div>

            <div className="detail-stat-grid">
  <DetailStat
    label="Version"
    value={selectedMemory?.version || "-"}
  />

  <DetailStat
    label="Trust"
    value={
      selectedMemory
        ? selectedMemory.trust.toFixed(2)
        : "-"
    }
  />

  <DetailStat
    label="Suspicion"
    value={
      selectedMemory
        ? selectedMemory.suspicion.toFixed(2)
        : "-"
    }
  />

  <DetailStat
    label="Status"
    value={selectedMemory?.status || "-"}
  />
</div>

            <div className="content-block">
              <span>MEMORY CONTENT</span>
              <p>
  {selectedMemory?.content || "No memory selected."}
</p>
            </div>

            <div className="content-block">
              <span>DATABASE STATUS</span>
              <div className="integrity-status">
                {String(selectedMemory?.status || "").toUpperCase() === "TRUSTED" ? (
                  <CheckCircle2 size={18} />
                ) : (
                  <ShieldAlert size={18} />
                )}
                {selectedMemory?.status
                  ? String(selectedMemory.status).replace(/_/g, " ")
                  : "Status unavailable"}
              </div>
              <small>
                This is the recorded memory status, not proof of owner authorization
                or independent integrity verification.
              </small>
            </div>

            <div className="content-block memory-timeline-section">

  <div className="timeline-header">
    <div>
      <span>MEMORY VERSION TIMELINE</span>
      <small>
        {memoryHistory.length} recorded versions
      </small>
    </div>

    {memoryHistory.length > 8 && (
      <span className="timeline-summary">
        Showing latest 8
      </span>
    )}
  </div>

  <div className="memory-timeline">

    {memoryHistory
      .slice(-8)
      .reverse()
      .map((version) => {

        const state =
  String(version.state || "").toUpperCase()

const compromised =
  state === "COMPROMISED"

const restoredState =
  state === "RESTORED"

const trustedState =
  state === "TRUSTED"

const timelineClass =
  compromised ? "corrupted" :
  restoredState ? "restored" :
  trustedState ? "trusted" : "unknown"

const timelineLabel =
  state || "STATE NOT RECORDED"




        return (
  <div
    className={`timeline-item ${timelineClass}`}
    key={version.id}
  >

    <div className="timeline-marker">
      {compromised ? (
        <AlertTriangle size={13} />
      ) : trustedState || restoredState ? (
        <CheckCircle2 size={13} />
      ) : (
        <Activity size={13} />
      )}
    </div>

    <div className="timeline-content">

      <div className="timeline-title">

        <strong>
          {version.version}
        </strong>

        <span
          className={`timeline-state ${
            compromised ? "danger" :
            restoredState ? "recovered" :
            trustedState ? "safe" : "unknown"
          }`}
        >
          {timelineLabel}
        </span>

              </div>

              <p>
                {version.content}
              </p>

              <small>
                Trust{" "}
                {Number(version.trust).toFixed(2)}
                {" · "}
                {version.status}
              </small>

              {compromised &&
                recoveryResult?.memory?.compromised?.attack_type && (
                  <div className="timeline-attack">

                    <AlertTriangle size={13} />

                    <span>
                      {
                        recoveryResult.memory.compromised.attack_type
                      }

                      {recoveryResult.memory.compromised.attacker
                        ? ` · ${recoveryResult.memory.compromised.attacker}`
                        : ""}
                    </span>

                  </div>
                )}

            </div>

          </div>
        )
      })}

  </div>

  {memoryHistory.length > 8 && (
    <div className="timeline-footer">
      <span>
        {memoryHistory.length - 8} earlier versions
        retained in persistent memory history.
      </span>
    </div>
  )}

</div>
          </section>
        </div>
      </div>
    )
  }

  if (!authChecked) {
    return <div style={{minHeight:"100vh",display:"grid",placeItems:"center",background:"#0b1220",color:"#e5e7eb"}}>Checking secure session...</div>
  }

  if (!authenticated) {
    return (
      <div style={{minHeight:"100vh",display:"grid",placeItems:"center",background:"#0b1220",color:"#e5e7eb",fontFamily:"Arial,sans-serif",padding:"24px"}}>
        <form onSubmit={handleLogin} style={{width:"100%",maxWidth:"400px",boxSizing:"border-box",padding:"32px",border:"1px solid #263449",borderRadius:"16px",background:"#111c2e"}}>
          <div style={{display:"flex",alignItems:"center",gap:"12px",marginBottom:"24px"}}>
            <ShieldCheck size={30} />
            <div><h1 style={{margin:0,fontSize:"24px"}}>AEGISMEM</h1><p style={{margin:"5px 0 0",color:"#9ca3af"}}>Memory Security Dashboard</p></div>
          </div>
          <label htmlFor="dashboard-password" style={{display:"block",marginBottom:"8px"}}>Dashboard password</label>
          <input id="dashboard-password" type="password" autoComplete="current-password" required value={loginPassword} onChange={(event) => setLoginPassword(event.target.value)} style={{width:"100%",boxSizing:"border-box",padding:"12px",borderRadius:"8px",border:"1px solid #475569",background:"#0b1220",color:"#fff",marginBottom:"16px"}} />
          {loginError && <p role="alert" style={{color:"#fca5a5",fontSize:"14px"}}>{loginError}</p>}
          <button type="submit" disabled={loginLoading} style={{width:"100%",padding:"12px",border:0,borderRadius:"8px",background:"#2563eb",color:"#fff",fontWeight:600,cursor:"pointer"}}>{loginLoading ? "Signing in..." : "Sign in securely"}</button>
        </form>
      </div>
    )
  }
  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-mark">
            <ShieldCheck size={22} />
          </div>
          <div>
            <strong>AEGISMEM</strong>
            <span>Memory Security</span>
          </div>
        </div>

        <nav className="nav">
  <NavItem
    icon={LayoutDashboard}
    label="Overview"
    active={page === "overview"}
    onClick={() => setPage("overview")}
  />

  <NavItem
    icon={Bot}
    label="AI Assistant"
    active={page === "assistant"}
    onClick={() => setPage("assistant")}
  />

  <NavItem
    icon={Database}
    label="Memory"
    active={page === "memory"}
    onClick={() => setPage("memory")}
  />

  <NavItem
    icon={ShieldAlert}
    label="Live Recovery"
    active={page === "attack"}
    onClick={() => setPage("attack")}
  />
</nav>

        <div className="sidebar-bottom">
          <div className="security-state">
            <span className="status-dot online"></span>
            <div>
              <strong>Protected</strong>
              <span>AegisMem active</span>
            </div>
          </div>
          <div className="user-profile">
            <div className="user-avatar">V</div>
            <div>
              <strong>Enterprise Operator</strong>
              <span>Administrator</span>
            </div>
          </div>
        </div>
      </aside>

      <main className="main-area">
        <header className="topbar">
          <div className="breadcrumb">
  AegisMem <span>/</span>{" "}
  {page === "overview"
    ? "Overview"
    : page === "assistant"
    ? "AI Assistant"
    : page === "memory"
? "Memory"
: page === "attack"
? "Live Recovery"
: "Memory"}
</div>

          <div className="topbar-actions">
            <button type="button" onClick={handleLogout} style={{padding:"8px 12px",border:"1px solid #475569",borderRadius:"8px",background:"transparent",color:"inherit",cursor:"pointer"}}>Logout</button>
            <span className="environment">
              <span className="status-dot online"></span>
              Research Environment
            </span>
            <div className="operator-avatar">V</div>
          </div>
        </header>

        {page === "overview" && renderOverview()}
        {page === "assistant" && renderAssistant()}
        {page === "memory" && renderMemory()}
        {page === "attack" && renderAttackLab()}
      </main>
    </div>
  )
}



function NavItem({ icon: Icon, label, active, onClick }) {
  return (
    <button className={`nav-item ${active ? "active" : ""}`} onClick={onClick}>
      <Icon size={18} />
      <span>{label}</span>
      {active && <span className="nav-active-indicator"></span>}
    </button>
  )
}

function StatCard({ icon: Icon, label, value, detail }) {
  return (
    <div className="stat-card">
      <div className="stat-icon">
        <Icon size={19} />
      </div>
      <span>{label}</span>
      <strong>{value}</strong>
      <small>{detail}</small>
    </div>
  )
}

function PipelineItem({ number, title, text, active }) {
  return (
    <div className={`pipeline-item ${active ? "active" : ""}`}>
      <span>{number}</span>
      <strong>{title}</strong>
      <p>{text}</p>
    </div>
  )
}

function DetailStat({ label, value }) {
  return (
    <div className="detail-stat">
      <span>{label}</span>
      <strong>{value}</strong>
    </div>
  )
}

export default App














































