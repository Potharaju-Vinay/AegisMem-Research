# Pre-built Adversary Container for AegisMem Benchmark (Hardened Milestone F4)
# Eliminates runtime apt-get execution on container startup
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    jq \
    python3 \
    && rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]

